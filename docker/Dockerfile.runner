# Frozen runner image for the sandboxed episode runner (design.md section 8).
# git + python3 (the fixture's hooks and request-review stub are python).
FROM python:3.12-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends git ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Commands run as a non-root, network-less, resource-limited container; the
# episode passes --user, --network none and limits at `docker run` time.
ENV GIT_TERMINAL_PROMPT=0
